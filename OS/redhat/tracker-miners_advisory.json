    "advisory": {
        "9": {
            "CVE-2026-1764": {
                "cve_id": "CVE-2026-1764",
                "title": "Amazon Linux 2023 - ALAS2023-2026-1580: Low priority package update for tracker-miners",
                "description": "A flaw was found in the GNOME localsearch MP3 Extractor `tracker-extract-mp3` component. A remote attacker could exploit this heap buffer overflow vulnerability by providing a specially crafted MP3 file containing malformed ID3 tags. This incorrect length calculation during the parsing of performer tags can lead to a read beyond the allocated buffer, potentially causing a Denial of Service (DoS) due to a crash or enabling information disclosure.",
                "severity": "MEDIUM",
                "status": "open",
