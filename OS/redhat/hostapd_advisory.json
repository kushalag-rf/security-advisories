    "package_name": "hostapd",
    "advisory": {
        "9": {
            "CVE-2022-37660": {
                "cve_id": "CVE-2022-37660",
                "title": "In hostapd 2.10 and earlier, the PKEX code remains active even af ...",
                "description": "In hostapd 2.10 and earlier, the PKEX code remains active even after a successful PKEX association. An attacker that successfully bootstrapped public keys with another entity using PKEX in the past, will be able to subvert a future bootstrapping by passively observing public keys, re-using the encrypting element Qi and subtracting it from the captured message M (X = M - Qi). This will result in the public ephemeral key X; the only element required to subvert the PKEX association.",
                "severity": "MEDIUM",
                "status": "open",
                "events": [
                    {
                        "introduced": "0",
                        "identifier": "el9"
                    }
                ]
            },
            "CVE-2023-52424": {
                "cve_id": "CVE-2023-52424",
                "title": "The IEEE 802.11 standard sometimes enables an adversary to trick  ...",
                "description": "The IEEE 802.11 standard sometimes enables an adversary to trick a victim into connecting to an unintended or untrusted network with Home WEP, Home WPA3 SAE-loop. Enterprise 802.1X/EAP, Mesh AMPE, or FILS, aka an \"SSID Confusion\" issue. This occurs because the SSID is not always used to derive the pairwise master key or session keys, and because there is not a protected exchange of an SSID during a 4-way handshake.",
                "severity": "HIGH",
                "status": "open",
                "events": [
                    {
                        "introduced": "0",
                        "identifier": "el9"
                    },
                    {
                        "introduced": "2.10-9.fc40",
                        "fixed": "2.11-1.fc40",
                        "identifier": "fc40"
                    }
                ]
            },
            "CVE-2025-24912": {
                "cve_id": "CVE-2025-24912",
                "title": "hostapd fails to process crafted RADIUS packets properly. When ho ...",
