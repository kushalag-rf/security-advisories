        "8": {
            "CVE-2026-35058": {
                "cve_id": "CVE-2026-35058",
                "title": "Amazon Linux 2023 - ALAS2023-2026-1644: Medium priority package update for openvpn",
                "description": "In a race condition an old TLS session could still try to send a packet but also get replaced by a new session. In this case, the buffer of the new session is still referenced. Add the check_session_buf_not_used function to mitigate this problem.",
                "severity": "MEDIUM",
                "status": "fixed",
